---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT, FORMS } from "../config/theme.config.ts";

const hasContactEndpoint = Boolean(FORMS.contact.action);
const contactAction = hasContactEndpoint ? FORMS.contact.action : "/contact";
const contactMethod = hasContactEndpoint ? FORMS.contact.method : "get";
const contactEnctype = hasContactEndpoint ? FORMS.contact.enctype : undefined;

const sent = Astro.url.searchParams.get("sent");
const hasError = Astro.url.searchParams.get("error");

const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout
  title={`Contact - ${SITE.name}`}
  description="Have a project in mind, a question about SEO or AEO, or just want to say hello? My inbox is open."
  canonical="/contact"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Contact" }]} />

    <header class="mt-6">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Contact</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold">Let's talk.</h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        Whether you need help with SEO, AEO, or AI-powered marketing — or just want to share something interesting — drop me a message. I read everything and reply to most of it.
      </p>
    </header>

    {sent === "true" && (
      <div class="mt-8 rounded-md border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-700 dark:text-green-400">
        Thanks for reaching out! Your message has been sent — I'll get back to you within 24–48 hours.
      </div>
    )}
    {hasError === "true" && (
      <div class="mt-8 rounded-md border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-700 dark:text-red-400">
        Something went wrong sending your message. Please try again or email me directly at {CONTACT.email}.
      </div>
    )}

    <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_240px]">
      <form
        id="contactForm"
        action={contactAction}
        method={contactMethod}
        enctype={contactEnctype}
        class="space-y-5"
      >
        <div>
          <label for="name" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Name</label>
          <input id="name" name="name" autocomplete="name" required class="mt-2 w-full border-0 border-b border-input bg-transparent py-2 text-base outline-none focus:border-primary" />
        </div>
        <div>
          <label for="email" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="mt-2 w-full border-0 border-b border-input bg-transparent py-2 text-base outline-none focus:border-primary" />
        </div>
        <div>
          <label for="subject" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Subject</label>
          <input id="subject" name="subject" required class="mt-2 w-full border-0 border-b border-input bg-transparent py-2 text-base outline-none focus:border-primary" />
        </div>
        <div>
          <label for="message" class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Message</label>
          <textarea id="message" name="message" required rows="6" class="mt-2 w-full border-0 border-b border-input bg-transparent py-2 text-base outline-none focus:border-primary"></textarea>
        </div>

        <!-- Honeypot: hidden from real users, bots often fill it in -->
        <input type="text" name="website" style="position:absolute; left:-9999px" tabindex="-1" autocomplete="off" />

        <!-- reCAPTCHA v3 token, filled in by JS right before submit -->
        <input type="hidden" id="recaptchaToken" name="recaptchaToken" />

        <button type="submit" class="rounded-md bg-foreground px-6 py-2.5 text-sm font-medium text-background hover:opacity-90">
          Send message
        </button>
      </form>

      <aside class="space-y-8 border-l border-border pl-8 lg:block">
        <div>
          <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Find me</div>
          <ul class="mt-3 space-y-3 text-sm">
            <li>
              <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 hover:text-primary">
                <Icon name="mail" class="h-3.5 w-3.5" /> {CONTACT.email}
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/howdypiyush/" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-primary">
                <Icon name="linkedin" class="h-3.5 w-3.5" /> LinkedIn
              </a>
            </li>
            <li>
              <a href="https://instagram.com/howdypiyush/" target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-primary">
                <Icon name="instagram" class="h-3.5 w-3.5" /> Instagram
              </a>
            </li>
            <li>
              <a href={CONTACT.socialUrl} target="_blank" rel="noreferrer" class="flex items-center gap-2 hover:text-primary">
                <Icon name="twitter" class="h-3.5 w-3.5" /> {CONTACT.socialHandle}
              </a>
            </li>
          </ul>
        </div>
        <div>
          <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Working together</div>
          <p class="mt-2 text-sm text-muted-foreground">I work with a small number of clients at a time. If you're looking for help with SEO, AEO, or AI-powered marketing — tell me about your business and what you're trying to achieve.</p>
        </div>
        <div>
          <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Response time</div>
          <p class="mt-2 text-sm text-muted-foreground">I typically reply within 24–48 hours on weekdays.</p>
        </div>
      </aside>
    </div>
  </div>

  <script src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`} is:inline></script>
  <script define:vars={{ siteKey: RECAPTCHA_SITE_KEY }}>
    const form = document.getElementById("contactForm");
    const tokenInput = document.getElementById("recaptchaToken");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      grecaptcha.ready(function () {
        grecaptcha.execute(siteKey, { action: "contact" }).then(function (token) {
          tokenInput.value = token;
          form.submit();
        });
      });
    });
  </script>
</BaseLayout>