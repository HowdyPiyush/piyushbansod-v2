---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { SOCIAL_LINKS } from "../config/theme.config.ts";

const { flush = false } = Astro.props;
---

<footer class:list={[flush ? "mt-0" : "mt-24", "border-t border-border/60"]}>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="font-serif text-lg font-semibold">{SITE.name}</div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
        {SITE.description}
      </p>
      <div class="mt-4 flex items-center gap-3 text-muted-foreground">
        {
          SOCIAL_LINKS.map((link) => (
            <a href={link.href} aria-label={link.label} target="_blank" rel="noreferrer" class="hover:text-foreground">
              <Icon name={link.icon} class="h-4 w-4" />
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Explore</div>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:block sm:space-y-2">
        <li><a href="/blog" class="text-foreground/80 hover:text-foreground">Blog</a></li>
        <li><a href="/projects" class="text-foreground/80 hover:text-foreground">Work</a></li>
        <li><a href="/services" class="text-foreground/80 hover:text-foreground">Services</a></li>
        <li><a href="/about" class="text-foreground/80 hover:text-foreground">About</a></li>
        <li><a href="/contact" class="text-foreground/80 hover:text-foreground">Contact</a></li>
      </ul>
    </div>
    <div>
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Topics</div>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:block sm:space-y-2">
        <li><a href="/categories/seo" class="text-foreground/80 hover:text-foreground">SEO</a></li>
        <li><a href="/categories/aeo" class="text-foreground/80 hover:text-foreground">AEO</a></li>
        <li><a href="/categories/ai" class="text-foreground/80 hover:text-foreground">AI</a></li>
        <li><a href="/categories/marketing" class="text-foreground/80 hover:text-foreground">Marketing</a></li>
        <li><a href="/categories/tools" class="text-foreground/80 hover:text-foreground">Tools</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-5 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <div>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</div>
    
    </div>
  </div>
</footer>