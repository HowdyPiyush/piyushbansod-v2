{
  "name": "quiet-pages",
  "version": "2.1.0",
  "description": "A quiet Astro magazine theme for essays, field notes, and long-form writing.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "tinacms build && astro build && node scripts/prune-unused-assets.mjs",
    "preview": "astro preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "@tailwindcss/vite": "^4.3.1",
    "@tinacms/astro": "^0.6.1",
    "astro": "^7.0.4",
    "tailwindcss": "^4.3.1",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^26.1.2",
    "prettier": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.1.2"
  }
}
